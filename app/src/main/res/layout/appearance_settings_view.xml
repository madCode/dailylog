<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.settings.AppearanceSettingsFragment">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/appearanceToolbar"
        style="@style/SettingsToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationContentDescription="@string/navigate_up"
        app:navigationIcon="@drawable/ic_arrow_back_24"
        app:title="@string/appearanceTitle" />

    <LinearLayout
        android:id="@+id/editorTextSizeRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/appearanceToolbar">

        <TextView
            android:id="@+id/editorTextSizeLabel"
            style="@style/TextHeadline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:labelFor="@id/editorTextSizeSlider"
            android:text="@string/editor_text_size" />

        <TextView
            android:id="@+id/editorTextSizeValue"
            style="@style/TextAppearance.MaterialComponents.Subtitle1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?android:attr/textColorSecondary"
            tools:text="14" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/editorTextSizeReset"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/reset"
            android:textColor="@color/secondary_text_button" />
    </LinearLayout>

    <com.google.android.material.slider.Slider
        android:id="@+id/editorTextSizeSlider"
        style="@style/SecondarySlider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:contentDescription="@string/editor_text_size"
        app:layout_constraintTop_toBottomOf="@id/editorTextSizeRow" />

    <!-- There is room for a second line here, which #82 could not afford inline; the preview
         string is still one line, so taking it is madCode's call rather than mine. -->
    <TextView
        android:id="@+id/editorTextSizePreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="8dp"
        android:maxLines="2"
        android:text="@string/editor_text_size_preview"
        app:layout_constraintTop_toBottomOf="@id/editorTextSizeSlider" />

</androidx.constraintlayout.widget.ConstraintLayout>
